# Haloop Vendas - configuração do servidor
# Use aspas simples nos valores: assim senhas com $ ou outros símbolos não são alteradas.

# Supabase > Connect > Session pooler (porta 5432), com a senha do banco
DATABASE_URL='postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-1-us-east-1.pooler.supabase.com:5432/postgres'

# Endereço público do sistema, com https e sem barra no final
BETTER_AUTH_URL='https://vendas.seudominio.com.br'

# Gere com: openssl rand -hex 32
BETTER_AUTH_SECRET='troque-por-uma-chave-longa'

VITE_AUTH_ENABLED=true
NFE_CERT_PATH='/opt/haloop-vendas/certificado.pfx'
